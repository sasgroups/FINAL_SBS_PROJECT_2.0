# ============================================
# KIOSK CONFIGURATION
# ============================================
PORT=8000
BAUD_RATE=9600
SCALE_PORT=COM3
SCANNER_PORT=COM4
KIOSK_FAST_MODE=true
ENABLE_REALSENSE=true
# ============================================
# CENTRAL SERVER CONFIGURATION
# ============================================
 API_URL=http://127.0.0.1:7000
# API_URL=http://10.1.10.107:7000  # Remove comment, use your central server
API_BASE_KIOSK=http://127.0.0.1:8000  # Use IPv4 explicitly
API_KEY=secret12345
# ENABLE_REALSENSE=false
REALSENSE_HEALTH_URL=http://127.0.0.1:5000/api/health
# ============================================
# DIAGNOSTICS CONFIGURATION
# ============================================
NODE_ENV=development
HOST=127.0.0.1
CLIENT_URL=http://localhost:3000

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Monitoring Intervals (in milliseconds)
UPDATE_INTERVAL_MS=2000
PING_TIMEOUT_MS=5000
STATUS_INTERVAL=10000

# Features
# ENABLE_REALSENSE=true
ENABLE_WEBSOCKET=true
ENABLE_SSE=true