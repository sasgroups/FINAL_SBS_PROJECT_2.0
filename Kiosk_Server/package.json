{
  "name": "central-server",
  "version": "1.0.0",
  "description": "Central backend to collect kiosk data and provide real-time dashboard updates",
  "main": "server.js",
   "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:obfuscate": "npm run bundle && npx javascript-obfuscator dist/app.js --output dist/app.obf.js",
    "bundle": "npx esbuild server.js --bundle --platform=node --outfile=dist/app.js --external:@serialport/* --external:bcrypt",
    "run:obfuscated": "node dist/app.obf.js",
    "build:pkg": "pkg . --targets node18-win-x64 --output kiosk-app.exe",
    "build:all": "npm run build:obfuscate && npm run build:pkg"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.5"
  },
"pkg": {
  "scripts": ["server.js"],
  "assets": [
    "node_modules/@serialport/**/*.node",
    "node_modules/bcrypt/**/*.node",
    "node_modules/axios/**/*"     
  ],
  "targets": ["node18-win-x64"],
  "outputPath": "dist"
},
  "devDependencies": {
    "esbuild": "^0.19.0",
    "javascript-obfuscator": "^4.1.0",
    "pkg": "^5.8.1"
  }
}